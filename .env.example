# ==========================================
# Repurpose - Environment Variables Config
# ==========================================

# ------------------------------------------
# Production Site Canonical URL (Mandatory for SEO)
# ------------------------------------------
# Used by robots.txt, sitemap.xml, canonical tags, and OpenGraph metadata.
# In Vercel, configure this in Project Settings -> Environment Variables for Production.
# Example: https://repurpose.vercel.app or your custom domain https://repurpose-research.org
# DO NOT include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://repurpose.vercel.app

# ------------------------------------------
# AI Engine (Groq / OpenAI-compatible API)
# ------------------------------------------
# Strictly used server-side in /api/repurposing/ai-summary
# Never exposed in client code.
# The application remains fully functional even if this key is omitted.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------
# Firebase Client Configuration
# ------------------------------------------
# Optional backend services. Repurpose operates as a privacy-first, read-only platform.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
