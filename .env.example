# ==========================================
# Repurpose - Environment Variables Config
# ==========================================

# ------------------------------------------
# AI Engine (Groq / OpenAI-compatible API)
# ------------------------------------------
# Strictly used server-side in /api/repurposing/ai-summary
# Never exposed in client code.
# The application remains fully functional even if this key is omitted.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------
# Firebase Client Configuration
# ------------------------------------------
# Enables cloud synchronization of saved drug dossiers, research notes, and user searches.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
